{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run check)",
      "Bash(npm run dev)",
      "Bash(npm run preview)",
      "Bash(npm audit)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "PowerShell(npm run build)",
      "PowerShell(npm run check)",
      "PowerShell(npm audit)",
      "PowerShell(git status)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "PowerShell(git push origin main:*)",
      "PowerShell(git push --force:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
