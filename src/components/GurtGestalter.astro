---
// Gurt-Gestalter: Modell, Material, Maße, Farben, Motiv und Ausstattung zusammenstellen – mit Skizze und Richtpreis.
// Ohne JavaScript bleibt der Startentwurf stehen; die Auswahl wird dann nicht übernommen.
import { hexFuer } from '../data/farben';
import { euro, laengen, preisgruppen } from '../data/preise';
import {
  arten,
  breiten,
  filzFarben,
  formen,
  materialien,
  materialVon,
  motive,
  schnallen,
  startAuswahl as start,
  kurzText,
  zuGurtOptionen,
  zusammenfassung,
  richtpreis,
} from '../data/konfigurator';
import { gurtSvg } from '../scripts/gurt-svg';

interface Props {
  /** eindeutiger Präfix, falls der Gestalter mehrfach auf einer Seite steht */
  id?: string;
  titelEbene?: 'h1' | 'h2';
  titel?: string;
}

const { id = 'gestalter', titelEbene = 'h2', titel = 'Gestalten Sie Ihren Gurt' } = Astro.props;
const Titel = titelEbene;
const Schritt = titelEbene === 'h1' ? 'h2' : 'h3';

const gruppe = preisgruppen[materialVon(start.material).gruppe];
const preis = euro(richtpreis(start).summe);
const liste = zusammenfassung(start).filter(([k]) => k !== 'Richtpreis');

/** Farbkreis; zweifarbige Kordeln als geteilter Kreis */
const kreis = (name: string) => {
  const [a, b] = hexFuer(name);
  return b
    ? `<path d="M16 3a13 13 0 0 0 0 26z" fill="${a}"/><path d="M16 3a13 13 0 0 1 0 26z" fill="${b}"/>`
    : `<circle cx="16" cy="16" r="13" fill="${a}"/>`;
};
---

<div class="gestalter" data-gestalter id={id}>
  <div class="gestalter__steuerung">
    <slot name="kopf" />
    <Titel class="gestalter__titel" id={`${id}-titel`}>{titel}</Titel>
    <slot />

    <Schritt class="gestalter__schritt"><span aria-hidden="true">1</span> Modell</Schritt>
    <fieldset class="wahl">
      <legend>Gurtart</legend>
      <div class="wahl__reihe">
        {
          arten.map((a) => (
            <label class="wahl__knopf">
              <input type="radio" name={`${id}-art`} value={a.id} checked={a.id === start.art} data-feld="art" />
              <span>
                {a.name}
                {a.id === 'western' && <small data-aufpreis="western">+{euro(gruppe.extras.western)}</small>}
              </span>
            </label>
          ))
        }
      </div>
    </fieldset>
    <fieldset class="wahl">
      <legend>Form</legend>
      <div class="wahl__reihe">
        {
          formen.map((f) => (
            <label class="wahl__knopf">
              <input type="radio" name={`${id}-form`} value={f.id} checked={f.id === start.form} data-feld="form" />
              <span>
                {f.name}
                {f.text && <small>{f.text}, +{euro(gruppe.extras.anatomisch)}</small>}
              </span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <Schritt class="gestalter__schritt"><span aria-hidden="true">2</span> Material und Maße</Schritt>
    <fieldset class="wahl">
      <legend>Material</legend>
      <div class="wahl__reihe">
        {
          materialien.map((m) => (
            <label class="wahl__knopf">
              <input type="radio" name={`${id}-material`} value={m.id} checked={m.id === start.material} data-feld="material" />
              <span>
                {m.name} <small>ab {euro(preisgruppen[m.gruppe].grundpreise[0])}</small>
              </span>
            </label>
          ))
        }
      </div>
    </fieldset>
    <fieldset class="wahl">
      <legend>Anzahl der Schnüre</legend>
      <div class="wahl__reihe">
        {
          breiten.map((b) => (
            <label class="wahl__knopf">
              <input type="radio" name={`${id}-schnuere`} value={b.wert} checked={b.wert === start.schnuere} data-feld="schnuere" />
              <span>
                <strong>{b.wert}</strong> <small>{b.text}</small>
              </span>
            </label>
          ))
        }
      </div>
    </fieldset>
    <fieldset class="wahl">
      <legend>Länge</legend>
      <div class="wahl__reihe">
        {
          laengen.map((l) => (
            <label class="wahl__knopf wahl__knopf--klein">
              <input type="radio" name={`${id}-laenge`} value={l} checked={l === start.laenge} data-feld="laenge" />
              <span>bis {l} cm</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <Schritt class="gestalter__schritt"><span aria-hidden="true">3</span> Farben und Muster</Schritt>
    {/* Je Material eine eigene Farbpalette; sichtbar ist nur die des gewählten Materials */}
    {
      materialien.map((m) => (
        <fieldset class="wahl" data-palette="grund" data-material={m.id} hidden={m.id !== start.material}>
          <legend>Farbe der Schnüre ({m.name})</legend>
          <div class="wahl__reihe">
            {m.farben.map((f) => (
              <label class="wahl__farbe" title={f}>
                <input type="radio" name={`${id}-grund-${m.id}`} value={f} checked={m.id === start.material && f === start.grund} data-feld="grund" />
                <svg viewBox="0 0 32 32" aria-hidden="true" set:html={kreis(f)} />
                <span class="visuell-versteckt">{f}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))
    }
    <fieldset class="wahl">
      <legend>Motiv</legend>
      <div class="wahl__reihe">
        {
          motive.map((mo) => (
            <label class="wahl__knopf wahl__knopf--klein">
              <input type="radio" name={`${id}-motiv`} value={mo.id} checked={mo.id === start.motiv} data-feld="motiv" />
              <span>
                {mo.name}
                {mo.id === 'dreieck' && <small>+{euro(gruppe.extras.dreiecke)}</small>}
              </span>
            </label>
          ))
        }
      </div>
    </fieldset>
    {
      materialien.map((m) => (
        <fieldset class="wahl" data-palette="motivFarbe" data-material={m.id} hidden={m.id !== start.material}>
          <legend>Motivfarbe ({m.name})</legend>
          <div class="wahl__reihe">
            {m.farben.map((f) => (
              <label class="wahl__farbe" title={f}>
                <input type="radio" name={`${id}-motivfarbe-${m.id}`} value={f} checked={m.id === start.material && f === start.motivFarbe} data-feld="motivFarbe" />
                <svg viewBox="0 0 32 32" aria-hidden="true" set:html={kreis(f)} />
                <span class="visuell-versteckt">{f}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))
    }

    <Schritt class="gestalter__schritt"><span aria-hidden="true">4</span> Ausstattung</Schritt>
    <fieldset class="wahl">
      <legend>Schnalle</legend>
      <div class="wahl__reihe">
        {
          schnallen.map((s) => (
            <label class="wahl__knopf">
              <input type="radio" name={`${id}-schnalle`} value={s.id} checked={s.id === start.schnalle} data-feld="schnalle" />
              <span>
                {s.name}
                {s.text && <small>{s.text}</small>}
                {s.id === 'messing' && <small data-aufpreis="messing">+{euro(gruppe.extras.messing)}</small>}
              </span>
            </label>
          ))
        }
      </div>
    </fieldset>
    <fieldset class="wahl">
      <legend>Schnallenschutz aus Wollfilz</legend>
      <div class="wahl__reihe">
        {
          filzFarben.map((f) => (
            <label class="wahl__farbe" title={f}>
              <input type="radio" name={`${id}-filz`} value={f} checked={f === start.filz} data-feld="filz" />
              <svg viewBox="0 0 32 32" aria-hidden="true" set:html={kreis(f)} />
              <span class="visuell-versteckt">{f}</span>
            </label>
          ))
        }
      </div>
    </fieldset>
    <fieldset class="wahl">
      <legend>Extra</legend>
      <div class="wahl__reihe">
        <label class="wahl__knopf wahl__knopf--klein">
          <input type="checkbox" name={`${id}-dring`} value="ja" checked={start.dRing} data-feld="dRing" />
          <span>Zusätzlicher D-Ring <small>+{euro(gruppe.extras.dRing)}</small></span>
        </label>
      </div>
    </fieldset>
  </div>

  <div class="gestalter__seite">
    <div class="gestalter__buehne">
      <div class="gestalter__gurt" data-gurt set:html={gurtSvg(zuGurtOptionen(start), `Skizze: ${kurzText(start)}`)} />
      <p class="gestalter__preis-kurz" aria-hidden="true" data-preis-kurz>ca. {preis}</p>
    </div>

    <div class="gestalter__ergebnis">
      <p class="gestalter__preis">
        <span>Richtpreis</span>
        <strong data-preis>ca. {preis}</strong>
      </p>
      <p class="hinweis">Zzgl. Versand – den endgültigen Preis stimmen wir persönlich ab.</p>
      <dl class="gestalter__liste" data-liste>
        {
          liste.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
      <p class="visuell-versteckt" aria-live="polite" data-meldung></p>
      <div class="knopf-reihe">
        <a class="knopf knopf--akzent" href="#kontakt" data-entwurf-anfragen>Diesen Entwurf anfragen</a>
      </div>
      <p class="hinweis">
        Eine Skizze zur Orientierung – Farben, Muster und Maße stimmen wir persönlich ab. Weitere Farben auf Anfrage.
      </p>
    </div>
  </div>
</div>

<script>
  import '../scripts/gestalter';
</script>
