---
import site from '../site.config';
import Kontaktformular from './Kontaktformular.astro';
import Kordel from './Kordel.astro';

interface Props {
  seite: string;
  vorlage?: string;
  titel?: string;
  text?: string;
}

const {
  seite,
  vorlage,
  titel = 'Sie wollen mehr wissen?',
  text = 'Dann schreiben Sie mir eine Nachricht oder rufen Sie an – ich berate Sie gern zu Material, Breite und Design.',
} = Astro.props;
const i = site.impressum;
---

<section class="abschnitt abschnitt--tanne" id="kontakt" aria-labelledby={`kontakt-titel-${seite}`}>
  <div class="breite kontakt-raster">
    <div>
      <Kordel farben={['#e7efee', '#e7efee', '#f3c86b', '#e7efee']} />
      <h2 id={`kontakt-titel-${seite}`}>{titel}</h2>
      <p class="einleitung">{text}</p>
      <div class="kontakt-box">
        <div class="kontakt-zeile">
          <span class="kontakt-zeile__symbol" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"></path></svg>
          </span>
          <p><span class="kontakt-zeile__titel">Telefon</span><a href={`tel:${i.telefonLink}`}>{i.telefon}</a></p>
        </div>
        <div class="kontakt-zeile">
          <span class="kontakt-zeile__symbol" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-10 6L2 7"></path></svg>
          </span>
          <p><span class="kontakt-zeile__titel">E-Mail</span><a href={`mailto:${i.email}`}>{i.email}</a></p>
        </div>
        <div class="kontakt-zeile">
          <span class="kontakt-zeile__symbol" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          </span>
          <p>
            <span class="kontakt-zeile__titel">Anschrift</span>
            {i.strasse}, {i.plzOrt}<br />
            <a href={site.routenplaner} rel="noopener">Route planen (Google Maps)</a>
          </p>
        </div>
      </div>
    </div>
    <Kontaktformular seite={seite} vorlage={vorlage} />
  </div>
</section>
