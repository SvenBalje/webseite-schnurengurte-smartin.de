---
import Base from '../layouts/Base.astro';
import Kontaktformular from '../components/Kontaktformular.astro';
import site from '../site.config';

const i = site.impressum;
---

<Base titel="Kontakt" beschreibung="Kontakt zu s.mARTin Schnurengurte: Simone Behrens, Schwarzer Weg 6, 19273 Brahlstorf. Telefon 0157 36972337, E-Mail oder Kontaktformular.">
  <section class="seitenkopf">
    <div class="breite">
      <h1>Kontakt</h1>
      <p class="einleitung">Ob Beratung, Bestellung oder Probegurt – ich freue mich auf Ihre Nachricht.</p>
    </div>
  </section>

  <section class="abschnitt abschnitt--wolle" aria-label="Kontaktdaten und Formular">
    <div class="breite kontakt-raster">
      <div class="kontakt-box">
        <div class="kontakt-zeile">
          <span class="kontakt-zeile__symbol" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"></path></svg>
          </span>
          <p><span class="kontakt-zeile__titel">Telefon</span><a href={`tel:${i.telefonLink}`}>{i.telefon}</a></p>
        </div>
        <div class="kontakt-zeile">
          <span class="kontakt-zeile__symbol" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-10 6L2 7"></path></svg>
          </span>
          <p><span class="kontakt-zeile__titel">E-Mail</span><a href={`mailto:${i.email}`}>{i.email}</a></p>
        </div>
        <div class="kontakt-zeile">
          <span class="kontakt-zeile__symbol" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          </span>
          <p>
            <span class="kontakt-zeile__titel">Anschrift</span>
            {i.inhaberin}<br />
            {i.strasse}<br />
            {i.plzOrt}
          </p>
        </div>
        <div class="kontakt-zeile">
          <span class="kontakt-zeile__symbol" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle></svg>
          </span>
          <p><span class="kontakt-zeile__titel">Instagram</span><a href={site.instagram} rel="noopener">s.martin_reitzubehoer</a></p>
        </div>
        <p class="knopf-reihe">
          <a class="knopf knopf--hell" href={site.routenplaner} rel="noopener">Route planen (Google Maps)</a>
        </p>
      </div>
      <div>
        <h2>Dann schreiben Sie mir eine Nachricht</h2>
        <Kontaktformular seite="kontakt" />
      </div>
    </div>
  </section>
</Base>
